class ImageProcessor:
    def __init__(self, config: VisualizerConfig):
        self.cfg = config
        self.font = _load_font(self.cfg.font_size)

        self.clahe = None
        if self.cfg.clahe_enabled:
            self.clahe = cv2.createCLAHE(
                clipLimit=self.cfg.clahe_clip_limit,
                tileGridSize=self.cfg.clahe_grid_size,
            )

    @staticmethod
    def _is_16bit_color(img: Image.Image, image_path: Path) -> bool:
        """True for 16-bit-per-channel RGB(A) TIFF/PNG (which Pillow truncates)."""
        if img.mode not in ("RGB", "RGBA"):
            return False
        suffix = image_path.suffix.lower()
        try:
            if suffix in (".tif", ".tiff"):
                bps = img.tag_v2.get(258)  # BitsPerSample
                if isinstance(bps, (tuple, list)):
                    bps = bps[0]
                return bps == 16
            if suffix == ".png":
                with open(image_path, "rb") as f:
                    header = f.read(26)
                return len(header) >= 25 and header[24] == 16  # IHDR bit depth
        except Exception:
            return False
        return False

    @staticmethod
    def _read_16bit_color(image_path: Path) -> Optional[np.ndarray]:
        """
        Pillow decodes 16-bit-per-channel RGB TIFF/PNG to 8 bits, so read those
        with OpenCV instead.  Returns float32 RGB in [0,1], or None if the file
        is not a 16-bit colour image.  EXIF orientation is applied by OpenCV.
        """
        try:
            buf = np.fromfile(str(image_path), dtype=np.uint8)  # unicode-safe
            arr = cv2.imdecode(buf, cv2.IMREAD_ANYDEPTH | cv2.IMREAD_COLOR)
        except Exception:
            return None
        if arr is None or arr.dtype != np.uint16 or arr.ndim != 3:
            return None
        return cv2.cvtColor(arr, cv2.COLOR_BGR2RGB).astype(np.float32) / 65535.0

    @staticmethod
    def _pil_to_float(img: Image.Image) -> Tuple[np.ndarray, int]:
        """Convert a Pillow image to float32 RGB [0,1] at its native depth."""
        mode = img.mode
        if mode.startswith("I;16"):
            arr = np.asarray(img).astype(np.float32) / 65535.0
            bits = 16
        elif mode == "I":
            # Pillow opens 16-bit greyscale PNG as "I"; treat as 16-bit range
            # unless values exceed it.
            raw = np.asarray(img).astype(np.float64)
            top = 65535.0 if raw.max() <= 65535 else float(raw.max())
            arr = (raw / top).astype(np.float32)
            bits = 16 if top == 65535.0 else 32
        elif mode == "F":
            raw = np.asarray(img).astype(np.float32)
            top = float(raw.max())
            arr = raw / top if top > 1.0 else raw
            bits = 32
        else:
            if mode not in ("RGB", "L"):
                img = img.convert("RGB")
            arr = np.asarray(img).astype(np.float32) / 255.0
            bits = 8
        if arr.ndim == 2:
            arr = np.repeat(arr[:, :, None], 3, axis=2)
        elif arr.shape[2] == 4:
            arr = arr[:, :, :3]
        return np.clip(arr, 0.0, 1.0), bits

    def _open_working_rgb(self, image_path: Path) -> Tuple[np.ndarray, dict]:
        """
        Open an image as float32 RGB [0,1], preserving 16-bit precision.

        Colour handling:
        * Recognised standard profiles (sRGB, Adobe RGB, ProPhoto) are decoded
          analytically at full precision; no ICC transform is applied.
        * Any other embedded ICC profile is converted to sRGB with LittleCMS
          (8-bit), and the working space is then sRGB.
        * Untagged images use the configured default colour space.
        The returned metadata["working_colorspace"] is the space the pixel
        values are actually in, and is what must be used for LAB conversion.
        """
        try:
            with Image.open(image_path) as img:
                source_mode = img.mode
                icc_bytes = img.info.get("icc_profile")
                icc_name = _profile_name(img)
                original_size = [img.width, img.height]

                # Detect BEFORE exif_transpose (which drops EXIF accessors).
                colorspace, cs_provenance = _detect_colorspace(
                    img, image_path, self.cfg.default_colorspace
                )
                recognised = icc_name is None or cs_provenance.startswith("ICC")

                rgb = (
                    self._read_16bit_color(image_path)
                    if self._is_16bit_color(img, image_path) else None
                )
                if rgb is not None:
                    bits = 16
                    img_t = None
                else:
                    img_t = ImageOps.exif_transpose(img)
                    rgb, bits = self._pil_to_float(img_t)

                working = colorspace
                if icc_bytes and not recognised:
                    if bits == 8 and img_t is not None:
                        try:
                            src_profile = ImageCms.ImageCmsProfile(io.BytesIO(icc_bytes))
                            dst_profile = ImageCms.createProfile("sRGB")
                            src_img = img_t if img_t.mode in ("RGB", "CMYK", "L") else img_t.convert("RGB")
                            converted = ImageCms.profileToProfile(
                                src_img, src_profile, dst_profile, outputMode="RGB"
                            )
                            rgb, _ = self._pil_to_float(converted)
                            working = "sRGB"
                            color_management = (
                                f"Unrecognised ICC profile '{icc_name}' converted to "
                                "sRGB with LittleCMS (8-bit) before LAB analysis."
                            )
                        except Exception as exc:
                            color_management = (
                                f"ICC profile '{icc_name}' could not be applied ({exc}); "
                                f"pixel values interpreted as {colorspace}."
                            )
                    else:
                        color_management = (
                            f"ICC profile '{icc_name}' is not a recognised standard "
                            f"space and cannot be applied at {bits}-bit; pixel values "
                            f"interpreted as {colorspace}."
                        )
                else:
                    color_management = (
                        f"Analytic {colorspace} -> XYZ -> CIELAB(D65) decode at "
                        f"{bits}-bit precision. Provenance: {cs_provenance}"
                    )

                if self.cfg.analysis_scale != 1.0:
                    h, w = rgb.shape[:2]
                    new_size = (
                        max(1, int(round(w * self.cfg.analysis_scale))),
                        max(1, int(round(h * self.cfg.analysis_scale))),
                    )
                    rgb = cv2.resize(rgb, new_size, interpolation=cv2.INTER_AREA)

                metadata = {
                    "source_mode": source_mode,
                    "source_bit_depth": bits,
                    "source_dimensions": original_size,
                    "analysis_dimensions": [int(rgb.shape[1]), int(rgb.shape[0])],
                    "icc_profile": icc_name,
                    "detected_colorspace": colorspace,
                    "working_colorspace": working,
                    "colorspace_provenance": cs_provenance,
                    "color_management": color_management,
                }
                return rgb, metadata

        except Exception as exc:
            raise RuntimeError(f"File load/color-management error: {exc}") from exc

    @staticmethod
    def _rgb_to_lab(rgb: np.ndarray, colorspace: str = "sRGB") -> np.ndarray:
        """
        Color-space-aware RGB -> CIELAB.
        Replaces OpenCV's hard-coded sRGB assumption.
        """
        return _custom_rgb_to_lab(rgb, colorspace)

    @staticmethod
    def _chroma_from_lab(lab: np.ndarray) -> np.ndarray:
        a = lab[:, :, 1]
        b = lab[:, :, 2]
        return np.sqrt(a * a + b * b).astype(np.float32)

    def _compute_lrc(self, lab: np.ndarray, chroma: np.ndarray) -> Tuple[np.ndarray, dict]:
        """
        Lightness-Relative Chroma with corrected bin-centre interpolation
        and edge-padded rolling-mean smoothing.
        """
        L = lab[:, :, 0]
        bin_width = self.cfg.lrc_bin_width
        n_bins = max(1, int(np.ceil(100.0 / bin_width)))
        edges = np.linspace(0.0, 100.0, n_bins + 1)

        # Integer bin index for histogramming
        if n_bins > 1:
            bin_idx = np.digitize(L, edges[1:-1])
        else:
            bin_idx = np.zeros(L.shape, dtype=np.int64)
        bin_idx = np.clip(bin_idx, 0, n_bins - 1)

        flat_bin = bin_idx.ravel()
        counts = np.bincount(flat_bin, minlength=n_bins)

        medians = np.full(n_bins, np.nan, dtype=np.float32)
        iqrs = np.full(n_bins, np.nan, dtype=np.float32)

        for b in range(n_bins):
            vals = chroma[bin_idx == b]
            if vals.size == 0:
                continue
            # Guard against tiny sample sizes: if < 50 pixels, mark as unreliable
            if vals.size < 50:
                # Use a robust estimate but flag it; we'll interpolate over it later
                pass
            medians[b] = float(np.median(vals))
            q1, q3 = np.percentile(vals, [25.0, 75.0])
            iqrs[b] = max(float(q3 - q1), self.cfg.lrc_iqr_floor)

        # Interpolate empty bins
        valid = ~np.isnan(medians)
        if not valid.any():
            medians[:] = 0.0
            iqrs[:] = self.cfg.lrc_iqr_floor
        else:
            x_all = np.arange(n_bins)
            x_valid = np.where(valid)[0]
            medians = np.interp(x_all, x_valid, medians[valid]).astype(np.float32)
            iqrs = np.interp(x_all, x_valid, iqrs[valid]).astype(np.float32)
            iqrs = np.maximum(iqrs, self.cfg.lrc_iqr_floor)

        # Rolling mean with edge padding (not zero padding)
        window = max(1, self.cfg.lrc_smooth_window)
        if window > 1 and n_bins >= window:
            kernel = np.ones(window, dtype=np.float32) / window
            pad = window // 2
            # Single convolution with 'same' mode after edge padding
            medians = np.convolve(
                np.pad(medians, pad, mode="edge"), kernel, mode="same"
            )[pad:pad + n_bins]
            iqrs = np.convolve(
                np.pad(iqrs, pad, mode="edge"), kernel, mode="same"
            )[pad:pad + n_bins]
            iqrs = np.maximum(iqrs, self.cfg.lrc_iqr_floor)

        # CORRECTED fractional interpolation referencing bin CENTRES.
        # Bin k covers [k*bin_width, (k+1)*bin_width), centre at (k+0.5)*bin_width.
        # We want bin_float such that centre maps to integer k.
        bin_float = (L / bin_width) - 0.5
        bin_low = np.clip(np.floor(bin_float).astype(np.int64), 0, n_bins - 1)
        bin_high = np.clip(bin_low + 1, 0, n_bins - 1)
        frac = bin_float - bin_low.astype(np.float32)
        frac = np.clip(frac, 0.0, 1.0)

        pixel_median = medians[bin_low] * (1.0 - frac) + medians[bin_high] * frac
        pixel_iqr = iqrs[bin_low] * (1.0 - frac) + iqrs[bin_high] * frac
        pixel_iqr = np.maximum(pixel_iqr, self.cfg.lrc_iqr_floor)

        lrc = ((chroma - pixel_median) / pixel_iqr).astype(np.float32)

        meta = {
            "bin_width": bin_width,
            "n_bins": n_bins,
            "smooth_window": window,
            "iqr_floor": self.cfg.lrc_iqr_floor,
            "band_counts": [int(c) for c in counts],
            "band_medians": [float(m) for m in medians],
            "band_iqrs": [float(i) for i in iqrs],
            "interpolation": "fractional_linear_at_bin_centres",
        }
        return lrc, meta

    @staticmethod
    def _otsu_threshold(arr: np.ndarray) -> float:
        """
        Compute Otsu threshold on a 1D float array.
        Uses data-adaptive bin count and masks zero-weight splits.
        """
        flat = arr.ravel()
        if flat.size == 0:
            return 1.0

        # Data-adaptive bin count: Freedman-Diaconis rule, bounded
        iqr = np.percentile(flat, 75) - np.percentile(flat, 25)
        if iqr > 0:
            bin_width = 2 * iqr / (flat.size ** (1.0 / 3.0))
            n_bins = max(64, min(512, int(np.ptp(flat) / bin_width)))
        else:
            n_bins = 256

        counts, bin_edges = np.histogram(flat, bins=n_bins)
        bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2.0

        weight1 = np.cumsum(counts)
        weight2 = np.cumsum(counts[::-1])[::-1]

        # Compute means with safeguarded weights for numerical stability,
        # but keep original weights for variance masking.
        weight1_safe = np.where(weight1 == 0, 1, weight1)
        weight2_safe = np.where(weight2 == 0, 1, weight2)

        mean1 = np.cumsum(counts * bin_centers) / weight1_safe
        mean2 = (np.cumsum((counts * bin_centers)[::-1]) / weight2_safe[::-1])[::-1]

        # Mask splits where either class has zero weight
        variance = weight1[:-1] * weight2[1:] * (mean1[:-1] - mean2[1:]) ** 2
        variance[weight1[:-1] == 0] = 0.0
        variance[weight2[1:] == 0] = 0.0

        if variance.max() == 0:
            return float(bin_centers[len(bin_centers) // 2])

        idx = int(np.argmax(variance))
        return float(bin_centers[idx])

    def _noise_floor_threshold(self, flat: np.ndarray, space: str) -> float:
        """
        Substrate noise-floor threshold (the method described in the README,
        ported from v3.0): histogram the feature, find the dominant peak (the
        paper/substrate), and walk up from it until the bin count drops below
        noise_fraction x peak count.  That point is the noise floor.
        """
        bin_width = 0.5 if space == "raw" else 0.1   # C*ab units / LRC units
        lo = float(min(0.0, flat.min()))
        hi = float(flat.max())
        n_bins = int(np.clip(np.ceil((hi - lo) / bin_width), 1, 4096))
        if hi - lo <= 0:
            return hi
        counts, edges = np.histogram(flat, bins=n_bins, range=(lo, hi))
        peak = int(np.argmax(counts))

        # Dominant high-feature population: tail model not trustworthy.
        if peak > n_bins * 0.90:
            return float(np.percentile(flat, 75))

        cutoff = counts[peak] * self.cfg.noise_fraction
        below = np.nonzero(counts[peak:] < cutoff)[0]
        if below.size:
            return float(edges[peak + below[0]])
        return float(edges[peak]) + (10.0 if space == "raw" else 2.0)

    def _compute_threshold(self, feature: np.ndarray, space: str) -> float:
        """Compute threshold according to the configured mode."""
        flat = feature.ravel()

        if self.cfg.threshold_mode == "noise_floor":
            threshold = self._noise_floor_threshold(flat, space)
            if space == "raw":
                # Below ~1 C*ab is indistinguishable from neutral.
                threshold = max(threshold, 1.0)
        elif self.cfg.threshold_mode == "otsu":
            threshold = self._otsu_threshold(flat)
        elif self.cfg.threshold_mode == "percentile":
            threshold = float(np.percentile(flat, self.cfg.percentile))
        else:  # fixed
            threshold = float(self.cfg.fixed_threshold)

        threshold += self.cfg.threshold_bias

        # For LRC, negative thresholds are meaningful; only clamp raw C*ab.
        if space == "raw" and threshold < 0:
            warnings.warn(
                f"Raw C*ab threshold clamped from {threshold:.3f} to 0.0"
            )
            threshold = 0.0
        return threshold

    def _threshold_for_sensitivity(self, nominal: float, factor: float, space: str) -> float:
        """Perturb the nominal threshold for the stability test."""
        # LRC is roughly zero-centered -> additive perturbation
        # Raw C*ab is positive-definite -> multiplicative perturbation
        if space == "lrc":
            delta = (factor - 1.0) * self.cfg.lrc_sensitivity_scale
            return nominal + delta
        # Same clamp as _compute_threshold, so factor 1.0 == nominal threshold.
        return max(nominal * factor, 0.0)

    @staticmethod
    def _jaccard(a: np.ndarray, b: np.ndarray) -> float:
        a = a.astype(bool)
        b = b.astype(bool)
        union = np.logical_or(a, b).sum()
        if union == 0:
            return 1.0
        return float(np.logical_and(a, b).sum() / union)

    def _sensitivity_metrics(self, feature: np.ndarray, space: str) -> dict:
        factors = self.cfg.sensitivity_factors
        nominal = self._compute_threshold(feature, space)
        thresholds = [
            self._threshold_for_sensitivity(nominal, float(f), space) for f in factors
        ]

        # Apply the same spatial filter as the reported mask, so the
        # stability metric describes the mask that is actually output.
        masks = [
            self._apply_spatial_filter((feature > t).astype(np.uint8)).astype(bool)
            for t in thresholds
        ]
        center_idx = min(
            range(len(factors)),
            key=lambda i: abs(factors[i] - 1.0)
        )
        center_mask = masks[center_idx]

        jaccards = [self._jaccard(center_mask, mask) for mask in masks]
        area_percentages = [float(mask.mean() * 100.0) for mask in masks]

        return {
            "factors": [float(x) for x in factors],
            "thresholds": [float(x) for x in thresholds],
            "chromatic_area_percent": area_percentages,
            "jaccard_to_nominal": jaccards,
            "nominal_index": center_idx,
            "min_jaccard_to_nominal": float(min(jaccards)),
            "nominal_mask_area_percent": float(center_mask.mean() * 100.0),
            "sensitivity_interpretation": (
                "Higher Jaccard indicates a more stable chroma mask "
                "under small threshold perturbations. Low Jaccard on a "
                "tiny nominal mask should be interpreted with caution."
            ),
        }

    def _apply_spatial_filter(self, binary: np.ndarray) -> np.ndarray:
        """
        Remove connected components smaller than min_component_area_pixels.
        Vectorized implementation.
        """
        if self.cfg.min_component_area_pixels <= 0:
            return binary

        n_labels, labels, stats, _ = cv2.connectedComponentsWithStats(
            binary, connectivity=8
        )

        if n_labels <= 1:
            return np.zeros_like(binary)

        # Vectorized: build a lookup table of which component IDs to keep
        keep = (stats[:, cv2.CC_STAT_AREA] >= self.cfg.min_component_area_pixels).astype(np.uint8)
        keep[0] = 0  # background (label 0) is never kept
        return keep[labels]

    def _threshold_and_map(self, feature: np.ndarray, space: str) -> Tuple[float, np.ndarray, np.ndarray, dict]:
        threshold = self._compute_threshold(feature, space)

        binary = (feature > threshold).astype(np.uint8)
        binary_filtered = self._apply_spatial_filter(binary)

        if space == "lrc":
            # Fixed tier anchors, but guard against threshold > mid collapse
            mid_anchor, high_anchor = 1.0, 2.0
            high_ramp = 1.0

            # If threshold exceeds mid, re-anchor tiers relative to threshold
            # so the faint tier doesn't collapse to zero width.
            mid = max(mid_anchor, threshold + 0.5)
            high = max(high_anchor, mid + 0.5)

            faint = np.clip(
                (feature - threshold) / max(mid - threshold, 1e-6), 0, 1
            ) * 0.4
            medium = np.clip(
                (feature - mid) / max(high - mid, 1e-6), 0, 1
            ) * 0.8
            strong = np.clip((feature - high) / high_ramp, 0, 1)
            alpha = np.maximum.reduce([faint, medium, strong]) * binary_filtered
        else:
            valid = feature[binary_filtered > 0]
            if valid.size == 0:
                mid, high = threshold + 5.0, threshold + 15.0
            else:
                mid = max(float(np.percentile(valid, 50)), threshold + 2.0)
                high = max(float(np.percentile(valid, 85)), mid + 2.0)

            high_ramp = max(5.0, (high - threshold) * 0.25)

            faint = np.clip(
                (feature - threshold) / max(mid - threshold, 1e-6), 0, 1
            ) * 0.4
            medium = np.clip(
                (feature - mid) / max(high - mid, 1e-6), 0, 1
            ) * 0.8
            strong = np.clip((feature - high) / high_ramp, 0, 1)
            alpha = np.maximum.reduce([faint, medium, strong]) * binary_filtered

        total_pixels = feature.size
        chromatic_pixels = int(binary_filtered.sum())
        chromatic_area_percent = (chromatic_pixels / total_pixels) * 100.0 if total_pixels > 0 else 0.0

        metrics = {
            "chroma_space": space,
            "threshold_method": self.cfg.threshold_mode,
            "threshold": float(threshold),
            "mid_threshold": float(mid),
            "high_threshold": float(high),
            "chromatic_area_percent": chromatic_area_percent,
            "faint_area_percent": float(
                ((binary_filtered > 0) & (feature <= mid)).mean() * 100
            ),
            "medium_area_percent": float(
                ((binary_filtered > 0) & (feature > mid) & (feature <= high)).mean() * 100
            ),
            "high_area_percent": float(
                ((binary_filtered > 0) & (feature > high)).mean() * 100
            ),
            "mean_feature": float(np.mean(feature)),
            "median_feature": float(np.median(feature)),
            "max_feature": float(np.max(feature)),
            "min_component_area_pixels": self.cfg.min_component_area_pixels,
            "retained_pixels_after_spatial_filter": chromatic_pixels,
        }

        return threshold, alpha, binary_filtered, metrics

    def _boost_chroma(self, rgb: np.ndarray) -> Image.Image:
        """rgb: sRGB display image, float32 [0,1]."""
        lab = self._rgb_to_lab(rgb, "sRGB")
        l, a, b = cv2.split(lab)

        factor = self.cfg.chroma_boost_factor
        a2 = a * factor
        b2 = b * factor

        # For the boost visual we need to go back to RGB.  Since OpenCV's
        # LAB2RGB assumes sRGB, we use a simplified sRGB path for the
        # presentation image (the boost is illustrative, not metrological).
        boosted = cv2.merge([l, a2, b2])
        return Image.fromarray(
            np.clip(cv2.cvtColor(boosted, cv2.COLOR_LAB2RGB) * 255.0, 0, 255)
            .astype(np.uint8)
        )

    def _create_segmented_visual(
        self, rgb: np.ndarray, alpha: np.ndarray
    ) -> Image.Image:
        """Create the alpha-composited segmented overlay."""
        sigma = self.cfg.presentation_alpha_sigma
        if sigma > 0.0:
            ksize = max(3, int(sigma * 3) * 2 + 1)
            alpha_blurred = cv2.GaussianBlur(alpha, (ksize, ksize), sigmaX=sigma)
        else:
            alpha_blurred = alpha

        # rgb is the sRGB display image
        lab = self._rgb_to_lab(rgb, "sRGB")
        l, a, b = cv2.split(lab)

        if self.clahe is not None:
            # CLAHE on small images can show tile artefacts; guard against it
            # tileGridSize is the NUMBER of tiles (cols, rows), not pixels.
            # Skip CLAHE when tiles would be smaller than ~16 px.
            h, w = rgb.shape[:2]
            cols, rows = self.cfg.clahe_grid_size
            if w // cols >= 16 and h // rows >= 16:
                l8 = np.clip(l / 100.0 * 255.0, 0, 255).astype(np.uint8)
                l_enhanced = self.clahe.apply(l8).astype(np.float32) / 255.0 * 100.0
            else:
                l_enhanced = l
        else:
            l_enhanced = l

        factor = self.cfg.chroma_boost_factor
        # For presentation, use OpenCV's LAB2RGB (sRGB assumption is acceptable
        # for the visual overlay since it is not used for metrology).
        boosted_lab = cv2.merge([l_enhanced, a * factor, b * factor])
        foreground = np.clip(
            cv2.cvtColor(boosted_lab, cv2.COLOR_LAB2RGB) * 255.0, 0, 255
        ).astype(np.float32)

        # Dark greyscale context: rgb is [0,1], so scale to 0-255 first.
        gray = cv2.cvtColor(rgb.astype(np.float32), cv2.COLOR_RGB2GRAY)
        background = np.repeat(
            (gray * 255.0 * 0.15)[:, :, None], 3, axis=2
        ).astype(np.float32)

        alpha3 = np.repeat(alpha_blurred[:, :, None], 3, axis=2)
        final = background * (1.0 - alpha3) + foreground * alpha3
        return Image.fromarray(np.clip(final, 0, 255).astype(np.uint8))

    @staticmethod
    def _categorical_mask(feature: np.ndarray, binary: np.ndarray, threshold: float, mid: float, high: float) -> np.ndarray:
        mask = np.zeros(feature.shape, dtype=np.uint16)  # 16-bit to safely hold 0-3
        mask[(binary > 0) & (feature <= mid)] = 1
        mask[(binary > 0) & (feature > mid) & (feature <= high)] = 2
        mask[(binary > 0) & (feature > high)] = 3
        return mask

    @staticmethod
    def _component_statistics(mask: np.ndarray, minimum_area: int = 0) -> dict:
        binary = (mask > 0).astype(np.uint8)
        n_labels, labels, stats, _ = cv2.connectedComponentsWithStats(
            binary, connectivity=8
        )

        areas = stats[1:, cv2.CC_STAT_AREA].astype(int)
        if minimum_area > 0:
            areas = areas[areas >= minimum_area]

        if areas.size == 0:
            return {
                "component_count": 0,
                "largest_component_pixels": 0,
                "median_component_pixels": 0.0,
            }

        return {
            "component_count": int(len(areas)),
            "largest_component_pixels": int(areas.max()),
            "median_component_pixels": float(np.median(areas)),
        }

    def _save_histogram(
        self, feature: np.ndarray, threshold: float, mid: float, high: float, path: Path, space: str
    ):
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt

        fig = plt.figure(figsize=(9, 5))
        ax = fig.add_subplot(111)
        flat = feature.ravel()
        ax.hist(flat, bins=min(200, int(np.sqrt(flat.size))))
        ax.axvline(threshold, linestyle="--", color="red", label=f"Threshold {threshold:.2f}")
        ax.axvline(mid, linestyle=":", color="orange", label=f"Mid {mid:.2f}")
        ax.axvline(high, linestyle=":", color="darkred", label=f"High {high:.2f}")

        if space == "lrc":
            ax.axvline(0.0, color="gray", linewidth=0.8, label="LRC=0 (band median)")
            ax.set_xlabel("Lightness-Relative Chroma (LRC, dimensionless)")
            ax.set_title("LRC distribution and segmentation thresholds")
        else:
            ax.set_xlabel("CIELAB chroma C*ab")
            ax.set_title("Chroma distribution and segmentation thresholds")

        ax.set_ylabel("Pixel count")
        ax.legend()
        fig.tight_layout()
        fig.savefig(path, dpi=150)
        plt.close(fig)

    def _wrap(self, text: str, max_w: float) -> list[str]:
        """Greedy word-wrap of text to max_w pixels with the current font."""
        measure = ImageDraw.Draw(Image.new("RGB", (1, 1)))
        lines, current = [], ""
        for word in text.split(" "):
            trial = f"{current} {word}".strip()
            if current and measure.textlength(trial, font=self.font) > max_w:
                lines.append(current)
                current = word
            else:
                current = trial
        if current:
            lines.append(current)
        return lines or [""]

    def _save_footer(self, img: Image.Image, left: str, right: str = "") -> Image.Image:
        w, h = img.size
        draw = ImageDraw.Draw(Image.new("RGB", (1, 1)))  # dummy for metrics
        line_h = draw.textbbox((0, 0), "Ag" + left + right, font=self.font)[3]
        left_w = draw.textlength(left, font=self.font)
        right_w = draw.textlength(right, font=self.font) if right else 0

        if not right or left_w + right_w + 40 <= w:
            lines = None  # single line: left-aligned + right-aligned
            n_lines = 1
        else:
            lines = self._wrap(left, w - 20) + self._wrap(right, w - 20)
            n_lines = len(lines)
        footer_h = max(FOOTER_HEIGHT, n_lines * (line_h + 4) + 20)

        out = Image.new("RGB", (w, h + footer_h), "white")
        out.paste(img, (0, 0))
        draw = ImageDraw.Draw(out)
        if lines is None:
            draw.text((10, h + 10), left, font=self.font, fill="black")
            if right:
                draw.text((w - right_w - 10, h + 10), right, font=self.font, fill="black")
        else:
            for k, line in enumerate(lines):
                draw.text((10, h + 10 + k * (line_h + 4)), line, font=self.font, fill="black")
        return out

    def _create_montage(
        self,
        original: Image.Image,
        chroma: Image.Image,
        segmented: Image.Image,
        fname: str,
        footer: str,
    ) -> Image.Image:
        w, h = original.size
        total_w = w * 3
        draw = ImageDraw.Draw(Image.new("RGB", (1, 1)))

        def text_w(t: str) -> float:
            return draw.textlength(t, font=self.font)

        line_h = draw.textbbox((0, 0), "Ag" + footer + fname, font=self.font)[3]
        pad = 8

        # Info lines: filename + footer on one line if they fit, otherwise
        # the footer is wrapped at " | " / spaces onto following lines.
        max_w = total_w - 40
        info_lines: list[str] = []
        if text_w(fname) + 30 + text_w(footer) <= max_w:
            info_lines.append(f"{fname}   {footer}")
        else:
            info_lines.append(fname)
            info_lines.extend(self._wrap(footer, max_w))

        label_y = h + pad
        rule_y = label_y + line_h + pad
        info_y = rule_y + pad
        footer_h = max(
            MONTAGE_FOOTER_HEIGHT,
            info_y - h + len(info_lines) * (line_h + 4) + pad,
        )

        montage = Image.new("RGB", (total_w, h + footer_h), "white")
        montage.paste(original, (0, 0))
        montage.paste(chroma, (w, 0))
        montage.paste(segmented, (w * 2, 0))

        draw = ImageDraw.Draw(montage)
        for i, text in enumerate([
            "Original", "Chroma Boosted", "Segmented Chroma"
        ]):
            draw.text(
                ((i * w) + (w - text_w(text)) / 2, label_y),
                text,
                font=self.font,
                fill="black",
            )

        draw.line([(0, rule_y), (total_w, rule_y)], fill="black", width=1)
        for k, line in enumerate(info_lines):
            draw.text(
                (20, info_y + k * (line_h + 4)), line, font=self.font, fill="black"
            )
        return montage

    def _process_single_space(
        self,
        img_path: Path,
        display_rgb: np.ndarray,
        chroma: np.ndarray,
        lrc: np.ndarray,
        space: str,
        source: dict,
        working_meta: dict,
        out_prefix: str,
        img_dir: Path,
        display_original: Image.Image,
        chroma_pil: Image.Image,
        lrc_meta: Optional[dict] = None,
    ) -> Tuple[bool, str, dict]:
        """Run the full analysis + visualization pipeline for one chroma space."""
        try:
            feature = lrc if space == "lrc" else chroma

            threshold, alpha, binary_filtered, metrics = self._threshold_and_map(feature, space)
            metrics["mean_chroma"] = float(np.mean(chroma))
            metrics["median_chroma"] = float(np.median(chroma))
            metrics["max_chroma"] = float(np.max(chroma))

            categorical = self._categorical_mask(
                feature, binary_filtered, threshold, metrics["mid_threshold"], metrics["high_threshold"]
            )
            metrics["component_statistics"] = self._component_statistics(
                categorical, self.cfg.min_component_area_pixels
            )

            if self.cfg.run_sensitivity_analysis:
                sensitivity = self._sensitivity_metrics(feature, space)
                metrics["sensitivity"] = sensitivity

            space_dir = img_dir / space
            space_dir.mkdir(exist_ok=True)

            if self.cfg.save_numerical_tiff:
                # FIX: save as 16-bit unsigned rather than 8-bit "L" mode
                Image.fromarray(categorical.astype(np.uint16)).save(
                    space_dir / f"{out_prefix}_mask.tif", compression="tiff_deflate"
                )

            # Resize alpha to display resolution for visualization
            alpha_display = cv2.resize(
                alpha,
                (display_rgb.shape[1], display_rgb.shape[0]),
                interpolation=cv2.INTER_LINEAR,
            )
            segmented_pil = self._create_segmented_visual(display_rgb, alpha_display)

            fidelity_tag = f"[{source['compression_label']}]"
            space_label = "LRC" if space == "lrc" else "C*ab"
            threshold_label = f"{self.cfg.threshold_mode}({space_label}):{threshold:.2f}"
            map_data = (
                f"Thr:{threshold:.2f} Mid:{metrics['mid_threshold']:.2f} "
                f"High:{metrics['high_threshold']:.2f} "
                f"Area:{metrics['chromatic_area_percent']:.2f}%"
            )

            chroma_saved = self._save_footer(
                chroma_pil,
                out_prefix,
                f"Chroma Boost {self.cfg.chroma_boost_factor:g}x {fidelity_tag}",
            )
            segmented_saved = self._save_footer(
                segmented_pil,
                out_prefix,
                f"Segmented ({space_label}) | {map_data} {fidelity_tag}",
            )

            suffix = "jpg" if self.cfg.output_format == "jpg" else "png"
            save_kwargs = {"quality": self.cfg.quality} if suffix == "jpg" else {}

            chroma_saved.save(space_dir / f"{out_prefix}_chroma_boost.{suffix}", **save_kwargs)
            segmented_saved.save(space_dir / f"{out_prefix}_segmented.{suffix}", **save_kwargs)

            montage = self._create_montage(
                display_original,
                chroma_pil,
                segmented_pil,
                out_prefix,
                f"{threshold_label} | {map_data} {fidelity_tag}",
            )
            montage.save(space_dir / f"{out_prefix}_montage.{suffix}", **save_kwargs)

            if self.cfg.save_histograms and _MATPLOTLIB_AVAILABLE:
                self._save_histogram(
                    feature,
                    threshold,
                    metrics["mid_threshold"],
                    metrics["high_threshold"],
                    space_dir / f"{out_prefix}_histogram.png",
                    space,
                )

            record = {
                "software_version": VERSION,
                "timestamp_utc": datetime.now(timezone.utc).isoformat(),
                "source": {
                    "path_relative": str(img_path.relative_to(self.cfg.input_dir)).replace(os.sep, "/"),
                    **source,
                    **working_meta,
                },
                "analysis": {
                    "chroma_space": space,
                    "analysis_scale": self.cfg.analysis_scale,
                    "output_scale": self.cfg.output_scale,
                    "lab_method": (
                        "Custom RGB->XYZ->LAB pipeline with Bradford adaptation; "
                        "D65 CIELAB reference; color-space aware."
                    ),
                    "chroma_definition": "sqrt(a*^2 + b*^2)",
                    "lrc_definition": (
                        "(C*ab - L*-band median) / max(L*-band IQR, lrc_iqr_floor)"
                    ),
                    "threshold_mode": self.cfg.threshold_mode,
                    "percentile": self.cfg.percentile if self.cfg.threshold_mode == "percentile" else None,
                    "noise_fraction": self.cfg.noise_fraction if self.cfg.threshold_mode == "noise_floor" else None,
                    "fixed_threshold": self.cfg.fixed_threshold if self.cfg.threshold_mode == "fixed" else None,
                    "threshold_bias": self.cfg.threshold_bias,
                    "min_component_area_pixels": self.cfg.min_component_area_pixels,
                    "lrc_bin_width": self.cfg.lrc_bin_width,
                    "lrc_smooth_window": self.cfg.lrc_smooth_window,
                    "lrc_iqr_floor": self.cfg.lrc_iqr_floor,
                },
                "results": metrics,
                "outputs": {
                    "mask_tiff": str((space_dir / f"{out_prefix}_mask.tif").relative_to(self.cfg.output_dir)) if self.cfg.save_numerical_tiff else None,
                    "chroma_boost_image": str((space_dir / f"{out_prefix}_chroma_boost.{suffix}").relative_to(self.cfg.output_dir)),
                    "segmented_image": str((space_dir / f"{out_prefix}_segmented.{suffix}").relative_to(self.cfg.output_dir)),
                    "montage_image": str((space_dir / f"{out_prefix}_montage.{suffix}").relative_to(self.cfg.output_dir)),
                    "histogram_image": str((space_dir / f"{out_prefix}_histogram.png").relative_to(self.cfg.output_dir)) if (self.cfg.save_histograms and _MATPLOTLIB_AVAILABLE) else None,
                },
            }

            if space == "lrc" and lrc_meta is not None:
                record["lrc_binning"] = lrc_meta

            if self.cfg.save_per_image_json:
                with open(space_dir / f"{out_prefix}_metadata.json", "w", encoding="utf-8") as f:
                    json.dump(record, f, indent=2, default=str)

            msg = (
                f"Space={space_label} Mode={self.cfg.threshold_mode} Threshold={threshold:.2f} | "
                f"Chroma={metrics['chromatic_area_percent']:.2f}% | "
                f"Components={metrics['component_statistics']['component_count']} | "
                f"{source['compression_label']}"
            )
            if source.get("compression_warning") and self.cfg.warn_on_low_fidelity:
                msg += f" | NOTE: {source['compression_warning']}"

            return True, msg, record

        except Exception as exc:
            return False, f"Failed {space}: {exc}", {
                "error": str(exc),
                "traceback": traceback.format_exc(),
            }


    def process_image(self, img_path: Path) -> Tuple[bool, str, list[dict]]:
        """
        Process one image in BOTH chroma spaces.
        """
        try:
            # Memory guard
            with Image.open(img_path) as img:  # header only; pixels not decoded
                if img.width * img.height > self.cfg.max_image_pixels:
                    raise RuntimeError(
                        f"Image exceeds max_image_pixels ({self.cfg.max_image_pixels}). "
                        f"Dimensions: {img.width}x{img.height}"
                    )

            source = assess_source(img_path)
            source["sha256"] = _sha256_file(img_path)
            rgb, working_meta = self._open_working_rgb(img_path)

            lab = self._rgb_to_lab(rgb, working_meta["working_colorspace"])
            chroma = self._chroma_from_lab(lab)
            lrc, lrc_meta = self._compute_lrc(lab, chroma)

            # --- Paths and directories (once) ---
            rel_path = img_path.relative_to(self.cfg.input_dir)
            rel_string = str(rel_path).replace(os.sep, "/")
            digest = hashlib.sha1(rel_string.encode("utf-8")).hexdigest()[:8]
            base_name = img_path.stem
            out_prefix = f"{base_name}__{digest}"

            img_dir = self.cfg.output_dir / out_prefix
            img_dir.mkdir(exist_ok=True)

            numerical_dir = img_dir / "numerical"
            numerical_dir.mkdir(exist_ok=True)

            # --- Numerical outputs (once) ---
            if self.cfg.save_numerical_tiff:
                Image.fromarray(chroma.astype(np.float32)).save(
                    numerical_dir / f"{out_prefix}_chroma.tif", compression="tiff_deflate"
                )
                Image.fromarray(lrc.astype(np.float32)).save(
                    numerical_dir / f"{out_prefix}_lrc.tif", compression="tiff_deflate"
                )

                if self.cfg.save_16bit_tiff_sidecar:
                    # Per-image min-max scaling (for viewing only); the scale
                    # is recorded in the JSON so values can be recovered.
                    c_max = float(chroma.max())
                    c16 = np.clip(chroma / max(c_max, 1e-9) * 65535, 0, 65535).astype(np.uint16)
                    Image.fromarray(c16).save(
                        numerical_dir / f"{out_prefix}_chroma_u16.tif"
                    )
                    l_min, l_max = float(lrc.min()), float(lrc.max())
                    l16 = np.clip((lrc - l_min) / max(l_max - l_min, 1e-9) * 65535, 0, 65535).astype(np.uint16)
                    working_meta["u16_sidecar_scaling"] = {
                        "chroma": {"value_at_0": 0.0, "value_at_65535": c_max},
                        "lrc": {"value_at_0": l_min, "value_at_65535": l_max},
                    }
                    Image.fromarray(l16).save(
                        numerical_dir / f"{out_prefix}_lrc_u16.tif"
                    )

            # --- Presentation images (once) ---
            # Render the analysed LAB to sRGB for display so that Adobe RGB /
            # ProPhoto sources are not shown with the wrong primaries.
            if working_meta["working_colorspace"] == "sRGB":
                display_src = rgb
            else:
                display_src = cv2.cvtColor(lab, cv2.COLOR_LAB2RGB)
            original_pil = Image.fromarray(
                np.clip(display_src * 255.0, 0, 255).astype(np.uint8)
            )
            del display_src
            if self.cfg.output_scale != 1.0:
                w, h = original_pil.size
                display_size = (
                    max(1, int(round(w * self.cfg.output_scale))),
                    max(1, int(round(h * self.cfg.output_scale))),
                )
                display_original = original_pil.resize(display_size, Image.Resampling.LANCZOS)
            else:
                display_original = original_pil
            display_rgb = np.asarray(display_original).astype(np.float32) / 255.0
            del rgb

            lab = None  # allow GC

            if self.cfg.save_thumbnail_original:
                suffix = "jpg" if self.cfg.output_format == "jpg" else "png"
                thumb_kwargs = {"quality": self.cfg.quality} if suffix == "jpg" else {}
                display_original.save(
                    img_dir / f"{out_prefix}_original.{suffix}", **thumb_kwargs
                )

            chroma_pil = self._boost_chroma(display_rgb)

            # --- Process both spaces ---
            space_records = []
            all_success = True
            msgs = []

            for space in ("raw", "lrc"):
                success, msg, record = self._process_single_space(
                    img_path,
                    display_rgb,
                    chroma,
                    lrc,
                    space,
                    source,
                    working_meta,
                    out_prefix,
                    img_dir,
                    display_original,
                    chroma_pil,
                    lrc_meta=lrc_meta if space == "lrc" else None,
                )
                if not success:
                    all_success = False
                msgs.append(msg)
                space_records.append(record)

            combined_msg = f"{out_prefix} | " + " | ".join(msgs)
            return all_success, combined_msg, space_records

        except Exception as exc:
            return False, f"Failed {img_path.name}: {exc}", [{
                "error": str(exc),
                "traceback": traceback.format_exc(),
            }]


