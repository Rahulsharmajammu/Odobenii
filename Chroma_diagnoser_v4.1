# -----------------------------------------------------------------------------
# Color-space detection
# -----------------------------------------------------------------------------

def _detect_colorspace(img: Image.Image, img_path: Path) -> Tuple[str, str]:
    """
    Detect color space from EXIF ColorSpace tag and/or ICC profile name.
    Returns (canonical_name, provenance_description).

    Canonical names: "sRGB", "Adobe RGB", "ProPhoto RGB"
    Default (FADGI-compliant): "ProPhoto RGB"
    """
    # 1. EXIF ColorSpace tag (0xA001)
    exif = img._getexif() if hasattr(img, "_getexif") else None
    if exif:
        cs_tag = exif.get(0xA001)
        if cs_tag == 1:
            return "sRGB", "EXIF ColorSpace=1 (sRGB)"
        elif cs_tag == 2:
            return "Adobe RGB", "EXIF ColorSpace=2 (Adobe RGB)"
        elif cs_tag == 65535:
            # Uncalibrated – fall through to ICC probe
            pass

    # 2. ICC profile description
    icc = img.info.get("icc_profile")
    if icc:
        try:
            profile = ImageCms.ImageCmsProfile(icc)
            name = ImageCms.getProfileName(profile).strip().lower()
            if "prophoto" in name or "romm" in name:
                return "ProPhoto RGB", f"ICC profile: {name}"
            elif "adobe" in name and "rgb" in name:
                return "Adobe RGB", f"ICC profile: {name}"
            elif "srgb" in name or "iec61966" in name:
                return "sRGB", f"ICC profile: {name}"
        except Exception:
            pass

    # 3. Filename / path heuristics (last resort)
    stem = img_path.stem.lower()
    if "prophoto" in stem or "_pp" in stem:
        return "ProPhoto RGB", "Filename heuristic: ProPhoto RGB"
    elif "adobe" in stem or "_argb" in stem:
        return "Adobe RGB", "Filename heuristic: Adobe RGB"

    # 4. FADGI default: widest gamut for archival master files
    return (
        "ProPhoto RGB",
        "No embedded color-space metadata detected; defaulting to ProPhoto RGB "
        "per FADGI 3rd-Ed recommendation for archival master files."
    )


# -----------------------------------------------------------------------------
# Custom RGB -> LAB pipeline (color-space aware)
# -----------------------------------------------------------------------------

def _gamma_decode(rgb: np.ndarray, colorspace: str) -> np.ndarray:
    """Linearize gamma-encoded RGB.  Input float32 [0,1]."""
    if colorspace == "ProPhoto RGB":
        # ProPhoto uses gamma 1.8 with a small linear segment below ~0.001953
        return np.where(rgb < 0.001953, rgb / 16.0, rgb ** 1.8)
    elif colorspace == "Adobe RGB":
        # Simple gamma 2.2
        return np.power(rgb, 2.2)
    else:  # sRGB – piecewise
        return np.where(
            rgb < 0.04045,
            rgb / 12.92,
            np.power((rgb + 0.055) / 1.055, 2.4)
        )


def _rgb_to_xyz(rgb: np.ndarray, colorspace: str) -> np.ndarray:
    """Linear RGB [0,1] -> XYZ (D65 or D50 depending on source space)."""
    linear = _gamma_decode(rgb, colorspace)
    M = _M_RGB_TO_XYZ[colorspace]
    # Vectorised matrix multiply: (H,W,3) @ (3,3) -> (H,W,3)
    xyz = linear @ M.T
    # Scale to absolute XYZ (matrices above are for [0,1] RGB -> [0,1] XYZ)
    if colorspace == "ProPhoto RGB":
        # ProPhoto matrix is for D50; white = [96.4212, 100, 82.5188]
        xyz = xyz * np.array([96.4212, 100.0, 82.5188])
    else:
        # sRGB and Adobe RGB are D65; white = [95.047, 100, 108.883]
        xyz = xyz * np.array([95.047, 100.0, 108.883])
    return xyz


def _bradford_adapt_d50_to_d65(xyz: np.ndarray) -> np.ndarray:
    """Bradford chromatic adaptation D50 -> D65.  xyz shape (..., 3)."""
    return xyz @ _BRADFORD_D50_TO_D65.T


def _xyz_to_lab(xyz: np.ndarray) -> np.ndarray:
    """
    CIELAB from XYZ (D65 reference).
    xyz: absolute XYZ values, shape (..., 3)
    """
    x, y, z = xyz[..., 0], xyz[..., 1], xyz[..., 2]
    xn, yn, zn = _XN_D65, _YN_D65, _ZN_D65

    fx = x / xn
    fy = y / yn
    fz = z / zn

    delta = 6 / 29
    def f(t):
        return np.where(t > delta ** 3, np.cbrt(t), (t / (3 * delta ** 2)) + (4 / 29))

    L = 116.0 * f(fy) - 16.0
    a = 500.0 * (f(fx) - f(fy))
    b = 200.0 * (f(fy) - f(fz))

    return np.stack([L, a, b], axis=-1).astype(np.float32)


def _custom_rgb_to_lab(rgb: np.ndarray, colorspace: str) -> np.ndarray:
    """
    Color-space-aware RGB -> CIELAB.
    rgb: float32 [0,1], shape (H,W,3)
    """
    xyz = _rgb_to_xyz(rgb, colorspace)
    if colorspace == "ProPhoto RGB":
        xyz = _bradford_adapt_d50_to_d65(xyz)
    return _xyz_to_lab(xyz)


