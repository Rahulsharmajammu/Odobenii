def _build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="Chroma Diagnostic Tool v4.1 chroma analysis"
    )
    # nargs='?' makes positionals optional; omitted args fall back to the
    # hardcoded constants above.
    p.add_argument(
        "input_dir",
        type=Path,
        nargs="?",
        default=Path(INPUT_DIR),
        help="Directory containing input images (default: INPUT_DIR constant)",
    )
    p.add_argument(
        "output_dir",
        type=Path,
        nargs="?",
        default=Path(OUTPUT_DIR),
        help="Directory for outputs (default: OUTPUT_DIR constant)",
    )
    p.add_argument("--analysis-scale", type=float, default=1.0)
    p.add_argument("--output-scale", type=float, default=0.5)
    p.add_argument(
        "--threshold-mode", choices=["otsu", "percentile", "fixed"], default="percentile"
    )
    p.add_argument("--percentile", type=float, default=90.0)
    p.add_argument("--fixed-threshold", type=float, default=5.0)
    p.add_argument("--threshold-bias", type=float, default=0.0)
    p.add_argument("--lrc-bin-width", type=float, default=1.0)
    p.add_argument("--lrc-smooth-window", type=int, default=3)
    p.add_argument("--lrc-iqr-floor", type=float, default=1.0)
    p.add_argument("--lrc-sensitivity-scale", type=float, default=0.5)
    p.add_argument("--chroma-boost", type=float, default=3.0)
    p.add_argument("--clahe", action=argparse.BooleanOptionalAction, default=True)
    p.add_argument("--clahe-clip", type=float, default=3.0)
    p.add_argument("--min-component-area", type=int, default=100)
    p.add_argument("--alpha-sigma", type=float, default=0.8)
    p.add_argument("--max-workers", type=int, default=None)
    p.add_argument("--format", choices=["png", "jpg"], default="png")
    p.add_argument("--quality", type=int, default=95)
    p.add_argument("--max-image-pixels", type=int, default=100_000_000)
    p.add_argument("--no-sensitivity", action="store_true")
    p.add_argument("--no-histograms", action="store_true")
    p.add_argument("--no-numerical-tiff", action="store_true")
    p.add_argument("--no-json", action="store_true")
    p.add_argument("--no-thumbnail", action="store_true")
    p.add_argument("--no-16bit-sidecar", action="store_true")
    return p


def main():
    from multiprocessing import freeze_support

    freeze_support()

    parser = _build_parser()
    args = parser.parse_args()

    config = VisualizerConfig(
        input_dir=args.input_dir,
        output_dir=args.output_dir,
        analysis_scale=args.analysis_scale,
        output_scale=args.output_scale,
        chroma_boost_factor=args.chroma_boost,
        threshold_mode=args.threshold_mode,
        percentile=args.percentile,
        fixed_threshold=args.fixed_threshold,
        threshold_bias=args.threshold_bias,
        lrc_bin_width=args.lrc_bin_width,
        lrc_smooth_window=args.lrc_smooth_window,
        lrc_iqr_floor=args.lrc_iqr_floor,
        lrc_sensitivity_scale=args.lrc_sensitivity_scale,
        clahe_enabled=args.clahe,
        clahe_clip_limit=args.clahe_clip,
        presentation_alpha_sigma=args.alpha_sigma,
        max_workers=args.max_workers,
        output_format=args.format,
        quality=args.quality,
        run_sensitivity_analysis=not args.no_sensitivity,
        save_histograms=not args.no_histograms,
        save_numerical_tiff=not args.no_numerical_tiff,
        save_per_image_json=not args.no_json,
        save_thumbnail_original=not args.no_thumbnail,
        save_16bit_tiff_sidecar=not args.no_16bit_sidecar,
        min_component_area_pixels=args.min_component_area,
        max_image_pixels=args.max_image_pixels,
    )

    print(f"Chroma Diagnostic Tool v{VERSION}")
    print(f"Input:  {config.input_dir}")
    print(f"Output: {config.output_dir}")
    print("Both raw C*ab and LRC spaces will be computed for every image.")
    print("Color-space default: ProPhoto RGB")

    if HEIC_SUPPORTED:
        print("HEIC/HEIF support: enabled")
    if not _MATPLOTLIB_AVAILABLE and config.save_histograms:
        print("matplotlib not installed -- histograms will be skipped.")

    results = run_batch(config)

    if results:
        successes = sum(ok for ok, _ in results)
        print(f"\nDone. {successes}/{len(results)} images processed successfully.")
        if successes < len(results):
            sys.exit(1)


if __name__ == "__main__":
    main()
