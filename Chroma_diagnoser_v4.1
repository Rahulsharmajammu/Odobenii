# Bradford chromatic adaptation matrix  D50 -> D65
_BRADFORD_D50_TO_D65 = np.array([
    [0.95557930, -0.02303755, 0.06316926],
    [-0.02828613, 1.00993728, 0.02100921],
    [0.01229970, -0.02048587, 1.32994705],
], dtype=np.float64)

# RGB -> XYZ (column vector) matrices
_M_RGB_TO_XYZ = {
    "sRGB": np.array([
        [0.4124564, 0.3575761, 0.1804375],
        [0.2126729, 0.7151522, 0.0721750],
        [0.0193339, 0.1191920, 0.9503041],
    ], dtype=np.float64),
    "Adobe RGB": np.array([
        [0.5767309, 0.1855540, 0.1881852],
        [0.2973769, 0.6273491, 0.0752741],
        [0.0270343, 0.0706872, 0.9911085],
    ], dtype=np.float64),
    "ProPhoto RGB": np.array([
        [0.7976749, 0.1351917, 0.0313534],
        [0.2880402, 0.7118741, 0.0000857],
        [0.0000000, 0.0000000, 0.8252100],
    ], dtype=np.float64),
}

# D65 white point for CIELAB reference
_XN_D65, _YN_D65, _ZN_D65 = 95.047, 100.0, 108.883

