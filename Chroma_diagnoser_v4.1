# -----------------------------------------------------------------------------
# Color-space detection
# -----------------------------------------------------------------------------

SUPPORTED_COLORSPACES = ("sRGB", "Adobe RGB", "ProPhoto RGB")


def _colorspace_from_profile_name(name: str) -> Optional[str]:
    """Map an ICC profile description to one of the analytic working spaces."""
    name = name.lower()
    if "prophoto" in name or "romm" in name:
        return "ProPhoto RGB"
    if "adobe" in name and "rgb" in name:
        return "Adobe RGB"
    if "srgb" in name or "iec61966-2" in name or "iec 61966-2" in name:
        return "sRGB"
    return None


def _exif_colorspace_tag(img: Image.Image) -> Optional[int]:
    """Read EXIF ColorSpace (0xA001) from the Exif sub-IFD, for any format."""
    try:
        exif = img.getexif()
        tag = exif.get_ifd(0x8769).get(0xA001)
        if tag is None:
            tag = exif.get(0xA001)
        return tag
    except Exception:
        return None


def _detect_colorspace(
    img: Image.Image, img_path: Path, default: str = "sRGB"
) -> Tuple[str, str]:
    """
    Detect the colour space from the ICC profile name and/or EXIF ColorSpace.
    Returns (canonical_name, provenance_description).

    Must be called on the image as opened (before ImageOps.exif_transpose,
    which returns a copy without the format-specific metadata accessors).
    """
    # 1. ICC profile description (most specific)
    icc = img.info.get("icc_profile")
    if icc:
        try:
            profile = ImageCms.ImageCmsProfile(io.BytesIO(icc))
            name = ImageCms.getProfileName(profile).strip()
            cs = _colorspace_from_profile_name(name)
            if cs:
                return cs, f"ICC profile: {name}"
        except Exception:
            pass

    # 2. EXIF ColorSpace tag
    cs_tag = _exif_colorspace_tag(img)
    if cs_tag == 1:
        return "sRGB", "EXIF ColorSpace=1 (sRGB)"
    if cs_tag == 2:
        # Not in the EXIF standard, but written by some cameras for Adobe RGB.
        return "Adobe RGB", "EXIF ColorSpace=2 (Adobe RGB, non-standard)"

    # 3. Filename heuristics (explicit words only)
    stem = img_path.stem.lower()
    if "prophoto" in stem:
        return "ProPhoto RGB", "Filename heuristic: 'prophoto'"
    if "adobergb" in stem or "adobe_rgb" in stem:
        return "Adobe RGB", "Filename heuristic: 'adobergb'"

    # 4. Configured default
    return default, (
        f"No recognised colour-space metadata; assumed {default} "
        "(configurable with --default-colorspace)."
    )


# -----------------------------------------------------------------------------
# Custom RGB -> LAB pipeline (color-space aware)
# -----------------------------------------------------------------------------

def _gamma_decode(rgb: np.ndarray, colorspace: str) -> np.ndarray:
    """Linearize gamma-encoded RGB.  Input float32 [0,1]."""
    if colorspace == "ProPhoto RGB":
        # ProPhoto uses gamma 1.8 with a small linear segment below ~0.001953
        return np.where(rgb < 0.001953, rgb / 16.0, rgb ** 1.8)
    elif colorspace == "Adobe RGB":
        # Adobe RGB (1998): pure power law, gamma 563/256
        return np.power(rgb, 563.0 / 256.0)
    else:  # sRGB – piecewise
        return np.where(
            rgb < 0.04045,
            rgb / 12.92,
            np.power((rgb + 0.055) / 1.055, 2.4)
        )


def _rgb_to_xyz(rgb: np.ndarray, colorspace: str) -> np.ndarray:
    """Linear RGB [0,1] -> XYZ (D65 or D50 depending on source space)."""
    linear = _gamma_decode(rgb.astype(np.float32, copy=False), colorspace)
    M = _M_RGB_TO_XYZ[colorspace].astype(np.float32)
    # Vectorised matrix multiply: (H,W,3) @ (3,3) -> (H,W,3).
    # The matrices already map RGB white to the reference white in relative
    # XYZ (Y = 1), so scaling to the 0-100 range is a single factor of 100.
    # (Scaling by the white point again would give neutral grey spurious
    # chroma once _xyz_to_lab divides by the white point.)
    return (linear @ M.T) * np.float32(100.0)


def _bradford_adapt_d50_to_d65(xyz: np.ndarray) -> np.ndarray:
    """Bradford chromatic adaptation D50 -> D65.  xyz shape (..., 3)."""
    return xyz @ _BRADFORD_D50_TO_D65.T.astype(np.float32)


def _xyz_to_lab(xyz: np.ndarray) -> np.ndarray:
    """
    CIELAB from XYZ (D65 reference).
    xyz: absolute XYZ values, shape (..., 3)
    """
    x, y, z = xyz[..., 0], xyz[..., 1], xyz[..., 2]
    xn, yn, zn = _XN_D65, _YN_D65, _ZN_D65

    fx = x / xn
    fy = y / yn
    fz = z / zn

    delta = 6 / 29
    def f(t):
        return np.where(t > delta ** 3, np.cbrt(t), (t / (3 * delta ** 2)) + (4 / 29))

    L = 116.0 * f(fy) - 16.0
    a = 500.0 * (f(fx) - f(fy))
    b = 200.0 * (f(fy) - f(fz))

    return np.stack([L, a, b], axis=-1).astype(np.float32)


def _custom_rgb_to_lab(rgb: np.ndarray, colorspace: str) -> np.ndarray:
    """
    Color-space-aware RGB -> CIELAB.
    rgb: float32 [0,1], shape (H,W,3)
    """
    xyz = _rgb_to_xyz(rgb, colorspace)
    if colorspace == "ProPhoto RGB":
        xyz = _bradford_adapt_d50_to_d65(xyz)
    return _xyz_to_lab(xyz)


