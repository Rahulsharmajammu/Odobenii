_proc: Optional[ImageProcessor] = None


def _init_worker(config: VisualizerConfig):
    global _proc
    cv2.setNumThreads(1)
    if _MATPLOTLIB_AVAILABLE:
        import matplotlib
        matplotlib.use("Agg")
    _proc = ImageProcessor(config)


def _worker_task(path: Path) -> Tuple[bool, str, list[dict]]:
    if _proc is None:
        raise RuntimeError("Worker processor was not initialized.")
    return _proc.process_image(path)


def collect_images(
    input_dir: Path, formats: set, exclude_dir: Optional[Path] = None
) -> list[Path]:
    images = []
    for p in input_dir.rglob("*"):
        if p.suffix.lower() not in formats or not p.is_file():
            continue
        try:
            resolved = p.resolve()
        except OSError:
            continue
        if not resolved.is_relative_to(input_dir):
            continue
        # Don't re-ingest outputs when output_dir lives inside input_dir.
        if exclude_dir is not None and resolved.is_relative_to(exclude_dir):
            continue
        images.append(p)
    return sorted(images)


def _sha256_file(path: Path, chunk_size: int = 1024 * 1024) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            chunk = f.read(chunk_size)
            if not chunk:
                break
            digest.update(chunk)
    return digest.hexdigest()


def _write_manifest(config: VisualizerConfig) -> Path:
    metadata_dir = config.output_dir / "metadata"
    metadata_dir.mkdir(exist_ok=True)

    manifest = {
        "software_version": VERSION,
        "run_timestamp_utc": datetime.now(timezone.utc).isoformat(),
        "python_version": sys.version,
        "platform": platform.platform(),
        "opencv_version": cv2.__version__,
        "numpy_version": np.__version__,
        "pillow_version": Image.__version__,
        "pillow_heif_supported": HEIC_SUPPORTED,
        "matplotlib_available": _MATPLOTLIB_AVAILABLE,
        "configuration": {
            "analysis_scale": config.analysis_scale,
            "output_scale": config.output_scale,
            "chroma_boost_factor": config.chroma_boost_factor,
            "threshold_mode": config.threshold_mode,
            "noise_fraction": config.noise_fraction,
            "percentile": config.percentile,
            "fixed_threshold": config.fixed_threshold,
            "threshold_bias": config.threshold_bias,
            "lrc_bin_width": config.lrc_bin_width,
            "lrc_smooth_window": config.lrc_smooth_window,
            "lrc_iqr_floor": config.lrc_iqr_floor,
            "lrc_sensitivity_scale": config.lrc_sensitivity_scale,
            "clahe_enabled": config.clahe_enabled,
            "clahe_clip_limit": config.clahe_clip_limit,
            "clahe_grid_size": list(config.clahe_grid_size),
            "presentation_alpha_sigma": config.presentation_alpha_sigma,
            "output_format": config.output_format,
            "output_quality": config.quality,
            "sensitivity_factors": list(config.sensitivity_factors),
            "min_component_area_pixels": config.min_component_area_pixels,
            "save_thumbnail_original": config.save_thumbnail_original,
            "save_16bit_tiff_sidecar": config.save_16bit_tiff_sidecar,
            "max_image_pixels": config.max_image_pixels,
            "default_colorspace": config.default_colorspace,
        },
    }

    path = metadata_dir / "run_manifest.json"
    with open(path, "w", encoding="utf-8") as f:
        json.dump(manifest, f, indent=2, default=str)
    return path


def _write_summary(config: VisualizerConfig, records: list[dict]) -> Path:
    summary_dir = config.output_dir / "summary"
    summary_dir.mkdir(exist_ok=True)
    path = summary_dir / "batch_summary.csv"

    fields = [
        "path_relative",
        "chroma_space",
        "compression_label",
        "source_bit_depth",
        "source_dimensions",
        "analysis_dimensions",
        "detected_colorspace",
        "threshold_method",
        "threshold",
        "mid_threshold",
        "high_threshold",
        "chromatic_area_percent",
        "faint_area_percent",
        "medium_area_percent",
        "high_area_percent",
        "mean_feature",
        "median_feature",
        "max_feature",
        "mean_chroma",
        "median_chroma",
        "max_chroma",
        "component_count",
        "largest_component_pixels",
        "median_component_pixels",
        "min_jaccard_to_nominal",
    ]

    with open(path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fields)
        writer.writeheader()

        for record in records:
            if "error" in record:
                continue
            row = {
                "path_relative": record["source"]["path_relative"],
                "chroma_space": record["results"]["chroma_space"],
                "compression_label": record["source"]["compression_label"],
                "source_bit_depth": record["source"]["source_bit_depth"],
                "source_dimensions": record["source"]["source_dimensions"],
                "analysis_dimensions": record["source"]["analysis_dimensions"],
                "detected_colorspace": record["source"].get("detected_colorspace", ""),
                **record["results"],
            }
            component = row.pop("component_statistics", {})
            row.update(component)

            sensitivity = row.pop("sensitivity", {})
            row["min_jaccard_to_nominal"] = sensitivity.get(
                "min_jaccard_to_nominal", ""
            )
            row.pop("lrc_binning", None)

            writer.writerow({key: row.get(key, "") for key in fields})

    return path


def run_batch(config: VisualizerConfig) -> list[tuple[bool, str]]:
    _write_manifest(config)

    images = collect_images(config.input_dir, config.formats, config.output_dir)
    total = len(images)

    if not images:
        print("Warning: No valid images found in", config.input_dir)
        return []

    print(f"Found {total} images.")
    print(f"Analysis scale: {config.analysis_scale}")
    print(f"Output scale:   {config.output_scale}")
    print(f"Threshold mode: {config.threshold_mode}")
    if config.threshold_mode == "percentile":
        print(f"Percentile:     {config.percentile}")
    elif config.threshold_mode == "noise_floor":
        print(f"Noise fraction: {config.noise_fraction}")
    elif config.threshold_mode == "fixed":
        print(f"Fixed threshold: {config.fixed_threshold}")
    print(f"LRC bin width:  {config.lrc_bin_width}")
    print(f"LRC smoothing:  {config.lrc_smooth_window} bins")
    print(f"Spatial filter: {config.min_component_area_pixels} px")
    print(f"Alpha blur:     {config.presentation_alpha_sigma} px")
    print(f"Max pixels:     {config.max_image_pixels}")
    print(f"Workers:        {config.max_workers or 'auto'}")
    print(f"Color space:    ICC/EXIF-aware; {config.default_colorspace} default")

    results = []
    records = []
    completed = 0

    with concurrent.futures.ProcessPoolExecutor(
        max_workers=config.max_workers,
        initializer=_init_worker,
        initargs=(config,),
    ) as executor:
        futures = {
            executor.submit(_worker_task, path): path
            for path in images
        }

        for future in concurrent.futures.as_completed(futures):
            path = futures[future]
            try:
                success, msg, space_records = future.result()
            except Exception as exc:
                success = False
                msg = f"Worker failure for {path.name}: {exc}"
                space_records = [{
                    "error": str(exc),
                    "traceback": traceback.format_exc(),
                    "source": {"path_relative": str(path.relative_to(config.input_dir))},
                }]

            completed += 1
            results.append((success, msg))
            records.extend(space_records)

            pct = completed / total * 100.0
            print(f"[{completed}/{total} | {pct:.1f}%] {msg}")

    _write_summary(config, records)
    return results


