THRESHOLD_MODES = ("noise_floor", "percentile", "otsu", "fixed")


@dataclass
class VisualizerConfig:
    input_dir: Path
    output_dir: Path
    analysis_scale: float = 1.0
    output_scale: float = 0.5
    chroma_boost_factor: float = 3.0
    threshold_mode: str = "noise_floor"
    noise_fraction: float = 0.01
    percentile: float = 90.0
    fixed_threshold: float = 5.0
    threshold_bias: float = 0.0
    lrc_bin_width: float = 1.0
    lrc_smooth_window: int = 3
    lrc_iqr_floor: float = 1.0
    lrc_sensitivity_scale: float = 0.5
    clahe_enabled: bool = True
    clahe_clip_limit: float = 3.0
    clahe_grid_size: Tuple[int, int] = (8, 8)
    presentation_alpha_sigma: float = 0.8
    font_size: int = 24
    max_workers: Optional[int] = None
    output_format: str = "png"
    quality: int = 95
    warn_on_low_fidelity: bool = True
    run_sensitivity_analysis: bool = True
    sensitivity_factors: Tuple[float, ...] = (
        0.90, 0.95, 1.00, 1.05, 1.10
    )
    save_histograms: bool = True
    save_numerical_tiff: bool = True
    save_per_image_json: bool = True
    save_thumbnail_original: bool = True
    save_16bit_tiff_sidecar: bool = True
    min_component_area_pixels: int = 100
    max_image_pixels: int = 100_000_000
    default_colorspace: str = "sRGB"
    formats: set = field(default_factory=lambda: set(VALID_EXTENSIONS))

    def __post_init__(self):
        self.input_dir = Path(self.input_dir).resolve()
        self.output_dir = Path(self.output_dir).resolve()

        if not self.input_dir.is_dir():
            raise ValueError(f"Input path is not a directory: {self.input_dir}")
        if self.output_dir.exists() and not self.output_dir.is_dir():
            raise ValueError(f"Output path is not a directory: {self.output_dir}")

        self.output_dir.mkdir(parents=True, exist_ok=True)

        if not (0 < self.analysis_scale <= 1.0):
            raise ValueError("analysis_scale must be > 0 and <= 1.0")
        if not (0 < self.output_scale <= 1.0):
            raise ValueError("output_scale must be > 0 and <= 1.0")
        if self.threshold_mode not in THRESHOLD_MODES:
            raise ValueError(f"threshold_mode must be one of {THRESHOLD_MODES}")
        if not (0 < self.noise_fraction < 1):
            raise ValueError("noise_fraction must be between 0 and 1")
        if not (0 < self.percentile <= 100):
            raise ValueError("percentile must be > 0 and <= 100")
        if self.fixed_threshold < 0:
            raise ValueError("fixed_threshold must be >= 0")
        if not (1 <= self.quality <= 100):
            raise ValueError("quality must be 1-100")
        if self.output_format not in ("png", "jpg"):
            raise ValueError("output_format must be 'png' or 'jpg'")
        if self.clahe_clip_limit <= 0:
            raise ValueError("clahe_clip_limit must be > 0")
        if any(f <= 0 for f in self.sensitivity_factors):
            raise ValueError("All sensitivity factors must be > 0")
        if self.min_component_area_pixels < 0:
            raise ValueError("min_component_area_pixels must be >= 0")
        if self.lrc_bin_width <= 0:
            raise ValueError("lrc_bin_width must be > 0")
        if self.lrc_smooth_window < 1:
            raise ValueError("lrc_smooth_window must be >= 1")
        if self.lrc_iqr_floor <= 0:
            raise ValueError("lrc_iqr_floor must be > 0")
        if self.lrc_sensitivity_scale <= 0:
            raise ValueError("lrc_sensitivity_scale must be > 0")
        if self.presentation_alpha_sigma < 0:
            raise ValueError("presentation_alpha_sigma must be >= 0")
        if self.max_image_pixels < 1:
            raise ValueError("max_image_pixels must be >= 1")
        if self.default_colorspace not in SUPPORTED_COLORSPACES:
            raise ValueError(
                f"default_colorspace must be one of {SUPPORTED_COLORSPACES}"
            )

        if HEIC_SUPPORTED:
            self.formats |= HEIC_EXTENSIONS


