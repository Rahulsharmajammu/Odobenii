def _find_system_fonts() -> list[Path]:
    candidates = []
    system = platform.system()

    if system == "Windows":
        font_dirs = [Path(os.environ.get("WINDIR", r"C:\Windows")) / "Fonts"]
        font_names = ["arial.ttf", "calibri.ttf", "segoeui.ttf"]
    elif system == "Darwin":
        font_dirs = [
            Path("/System/Library/Fonts"),
            Path("/Library/Fonts"),
            Path.home() / "Library/Fonts",
        ]
        font_names = ["Arial.ttf", "Helvetica.ttc", "SFPro.ttf"]
    else:
        font_dirs = [
            Path("/usr/share/fonts"),
            Path("/usr/local/share/fonts"),
            Path.home() / ".fonts",
            Path.home() / ".local/share/fonts",
        ]
        font_names = [
            "DejaVuSans.ttf", "LiberationSans-Regular.ttf",
            "FreeSans.ttf", "NotoSans-Regular.ttf", "Ubuntu-R.ttf",
        ]

    if system != "Windows":
        try:
            result = subprocess.run(
                ["fc-list", ":file", "-f", "%{file}\n"],
                capture_output=True, text=True, timeout=5, check=False,
            )
            if result.returncode == 0:
                for line in result.stdout.splitlines():
                    p = Path(line.strip())
                    if p.exists():
                        candidates.append(p)
        except (FileNotFoundError, subprocess.TimeoutExpired):
            pass

    for d in font_dirs:
        if not d.exists():
            continue
        for name in font_names:
            for found in d.rglob(name):
                if found.is_file():
                    candidates.append(found)

    return candidates


def _load_font(size: int) -> ImageFont.ImageFont:
    for font_path in _find_system_fonts():
        try:
            return ImageFont.truetype(str(font_path), size)
        except (OSError, IOError):
            continue
    return ImageFont.load_default()


# -----------------------------------------------------------------------------
# Source inspection
# -----------------------------------------------------------------------------

def _parse_jpeg_sof(path: Path) -> Optional[dict]:
    """
    Parse JPEG Start-Of-Frame segment for chroma subsampling.
    Handles 0xFF stuffing correctly and reads a larger buffer for
    images with heavy metadata before SOF.
    """
    try:
        with open(path, "rb") as f:
            data = f.read(2_097_152)  # 2 MB buffer for large EXIF/ICC
    except OSError:
        return None

    if not data.startswith(b"\xff\xd8"):
        return None

    i = 2
    while i < len(data) - 1:
        if data[i] != 0xFF:
            i += 1
            continue

        marker = data[i + 1]

        if marker == 0xFF:
            i += 1
            continue

        if marker == 0xD9:  # EOI
            break
        if marker in (0xD8, 0x00, 0x01):
            i += 2
            continue
        if 0xD0 <= marker <= 0xD9:
            i += 2
            continue

        if i + 3 >= len(data):
            break

        length = struct.unpack(">H", data[i + 2:i + 4])[0]
        segment_end = i + 2 + length

        if marker in (
            0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7,
            0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF
        ):
            if segment_end > len(data):
                break

            num_components = data[i + 9]
            sampling = {}
            for c in range(num_components):
                off = i + 10 + c * 3
                comp_id = data[off]
                samp = data[off + 1]
                sampling[comp_id] = ((samp >> 4) & 0x0F, samp & 0x0F)

            y_samp = sampling.get(1, (0, 0))
            cb_samp = sampling.get(2, (0, 0))
            cr_samp = sampling.get(3, (0, 0))

            if y_samp == (2, 2) and cb_samp == (1, 1) and cr_samp == (1, 1):
                subsampling = "4:2:0"
            elif y_samp == (2, 1) and cb_samp == (1, 1) and cr_samp == (1, 1):
                subsampling = "4:2:2"
            elif y_samp == (1, 1) and cb_samp == (1, 1) and cr_samp == (1, 1):
                subsampling = "4:4:4"
            elif y_samp == (4, 1) and cb_samp == (1, 1) and cr_samp == (1, 1):
                subsampling = "4:1:1"
            else:
                subsampling = f"Y{y_samp} Cb{cb_samp} Cr{cr_samp}"

            return {"subsampling": subsampling}

        i = segment_end

    return None


def _profile_name(img: Image.Image) -> Optional[str]:
    icc = img.info.get("icc_profile")
    if not icc:
        return None
    try:
        profile = ImageCms.ImageCmsProfile(icc)
        name = ImageCms.getProfileName(profile).strip()
        return name or "embedded ICC profile"
    except Exception:
        return "embedded ICC profile (name unavailable)"


def _source_bit_depth(img: Image.Image) -> Optional[int]:
    if img.mode in ("I;16", "I;16L", "I;16B"):
        return 16
    if img.mode == "I":
        return 32
    if img.mode in ("RGB", "RGBA", "L", "P", "CMYK", "YCbCr"):
        return 8
    return None


def _source_max_value(img: Image.Image) -> float:
    """Return the nominal max value for the source mode to scale to [0,1]."""
    if img.mode in ("I;16", "I;16L", "I;16B"):
        return 65535.0
    if img.mode == "I":
        # 32-bit signed integer; use actual max present to avoid clipping.
        arr = np.asarray(img)
        return float(arr.max()) if arr.size > 0 else float(np.iinfo(np.int32).max)
    return 255.0


def assess_source(img_path: Path) -> dict:
    suffix = img_path.suffix.lower()

    info = {
        "format": suffix.lstrip(".").upper(),
        "compression_label": "unknown",
        "compression_warning": None,
        "chroma_subsampling": None,
        "icc_profile": None,
        "source_mode": None,
        "source_bit_depth": None,
        "source_dimensions": None,
        "color_management": "No embedded ICC profile detected; input interpreted as sRGB.",
    }

    try:
        with Image.open(img_path) as img:
            info["source_mode"] = img.mode
            info["source_bit_depth"] = _source_bit_depth(img)
            info["source_dimensions"] = [img.width, img.height]
            info["icc_profile"] = _profile_name(img)

            if info["icc_profile"]:
                info["color_management"] = (
                    "Embedded ICC profile detected; image is converted to the "
                    "defined sRGB working space before Lab analysis when possible."
                )
    except Exception as exc:
        info["compression_warning"] = f"Could not inspect image metadata: {exc}"
        return info

    if suffix == ".png":
        info["compression_label"] = "PNG lossless"
    elif suffix == ".bmp":
        info["compression_label"] = "BMP (typically uncompressed)"
    elif suffix == ".gif":
        info["compression_label"] = "GIF indexed/paletted"
        info["compression_warning"] = (
            "GIF uses an indexed palette of up to 256 colors; colorimetric "
            "fidelity may be lower than the original RGB source."
        )
    elif suffix in (".tif", ".tiff"):
        try:
            with Image.open(img_path) as im:
                compression = str(im.info.get("compression", "unknown")).lower()
        except Exception:
            compression = "unknown"

        if compression in ("jpeg", "old-jpeg"):
            info["compression_label"] = "TIFF with JPEG compression"
            info["compression_warning"] = (
                "This TIFF contains JPEG compression; chroma fidelity may be reduced."
            )
        elif compression == "unknown":
            info["compression_label"] = "TIFF compression unknown"
            info["compression_warning"] = "TIFF compression could not be determined."
        else:
            info["compression_label"] = f"TIFF ({compression})"
    elif suffix == ".webp":
        try:
            with Image.open(img_path) as im:
                lossless = im.info.get("lossless")
        except Exception:
            lossless = None

        if lossless is True:
            info["compression_label"] = "WebP lossless"
        elif lossless is False:
            info["compression_label"] = "WebP lossy"
            info["compression_warning"] = (
                "Lossy WebP compression may reduce chromatic fidelity."
            )
        else:
            info["compression_label"] = "WebP compression mode unknown"
            info["compression_warning"] = (
                "Could not determine whether this WebP is lossy or lossless."
            )
    elif suffix in HEIC_EXTENSIONS:
        info["compression_label"] = "HEIC/HEIF"
        info["compression_warning"] = (
            "HEIC/HEIF compression characteristics were not independently "
            "decoded by this tool; encoder settings determine fidelity."
        )
    elif suffix in (".jpg", ".jpeg"):
        sof = _parse_jpeg_sof(img_path)
        if sof is None:
            info["compression_label"] = "JPEG; subsampling unknown"
            info["compression_warning"] = (
                "JPEG is lossy; chroma subsampling could not be determined."
            )
        else:
            sub = sof["subsampling"]
            info["chroma_subsampling"] = sub
            info["compression_label"] = f"JPEG {sub}"
            if sub == "4:4:4":
                info["compression_warning"] = (
                    "No chroma subsampling, but JPEG DCT quantization remains lossy."
                )
            elif sub == "4:2:2":
                info["compression_warning"] = (
                    "Horizontal chroma resolution is reduced; fine color boundaries "
                    "may be blurred."
                )
            elif sub == "4:2:0":
                info["compression_warning"] = (
                    "Chroma resolution is substantially reduced in both dimensions; "
                    "fine color-boundary segmentation may be affected."
                )
            else:
                info["compression_warning"] = (
                    "Non-standard chroma subsampling detected."
                )

    return info


